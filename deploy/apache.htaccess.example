# ─────────────────────────────────────────────────────────────
# eduQR — Apache .htaccess for the public/ directory
#
# Copy to public/.htaccess.
# The Apache DocumentRoot (or cPanel domain root) MUST point at public/.
# ─────────────────────────────────────────────────────────────

Options -Indexes -MultiViews

# ── Front controller ──────────────────────────────────────────
RewriteEngine On

# Pass-through for real files and directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else through index.php
RewriteRule ^ index.php [L,QSA]

# ── Block sensitive files ──────────────────────────────────────
# The web root is public/, so .env / logs / SQL files should never
# be reachable from the web — these rules are a belt-and-suspenders guard.
<FilesMatch "\.(env|log|sql|json|lock|sh|bak|old|pem|key)$">
    Require all denied
</FilesMatch>

# Block dot-files (allow .well-known for Let's Encrypt ACME challenges)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\.                         - [F,L]

# ── Force HTTPS (enable in production) ────────────────────────
# Uncomment after verifying HTTPS is working to avoid lockout.
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Security headers ──────────────────────────────────────────
# These complement the headers sent by Bootstrap.php.
# Enable mod_headers: a2enmod headers (Debian) or via cPanel.
<IfModule mod_headers.c>
    Header always set X-Frame-Options            "DENY"
    Header always set X-Content-Type-Options     "nosniff"
    Header always set Referrer-Policy            "strict-origin-when-cross-origin"
    Header always set Permissions-Policy         "geolocation=(), microphone=(), camera=()"

    # HSTS — enable only after HTTPS is confirmed working
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Remove server fingerprint headers
    Header unset X-Powered-By
    Header always unset Server
</IfModule>

# ── PHP runtime settings (shared hosting) ─────────────────────
<IfModule mod_php8.c>
    php_flag  display_errors         Off
    php_flag  display_startup_errors Off
    php_value error_reporting        0
    php_flag  log_errors             On
    php_value session.cookie_httponly 1
    php_value session.cookie_secure   1
    php_value session.cookie_samesite Lax
    php_value session.use_strict_mode 1
</IfModule>

# ── Static asset caching ──────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
    ExpiresByType text/css              "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
