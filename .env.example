# ─────────────────────────────────────────────────────────────
# eduQR — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env. NEVER put real secrets in .env.example.
# ─────────────────────────────────────────────────────────────

# --- Application ---------------------------------------------
APP_NAME=eduQR
# production | development
APP_ENV=production
# Public base URL, no trailing slash. Used to build join URLs and QR codes.
APP_URL=https://eduqr.example.org
# Toggle verbose errors. MUST be false in production.
APP_DEBUG=false
# 32 random bytes, base64-encoded. Generate with: php bin/rotate-secret.php
# Used to salt device-hash computation.
APP_SECRET=

# --- Localization --------------------------------------------
# Default + fallback locale.
APP_LOCALE_DEFAULT=en
# Comma-separated list of active locales. Each needs a locales/<code>.json file.
APP_LOCALES=en,tr

# --- Database ------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eduqr
DB_USER=eduqr_app
DB_PASS=
# Charset is fixed to utf8mb4 in code; do not change.

# --- Sessions & Cookies --------------------------------------
SESSION_NAME=eduqr_session
# Instructor session inactivity timeout, in minutes (default 720 = 12h).
SESSION_LIFETIME_MINUTES=720
# Set true in production (HTTPS). May be false only for local HTTP dev.
COOKIE_SECURE=true
# Lax | Strict
COOKIE_SAMESITE=Lax

# --- Polling intervals (milliseconds) ------------------------
# Surfaced to the frontend. Defaults match SYSTEM_ARCHITECTURE.md §1.
POLL_INTERVAL_INSTRUCTOR_MS=2000
POLL_INTERVAL_STUDENT_MS=3000

# --- Session behavior ----------------------------------------
# Hours after creation before an unclosed session auto-closes.
SESSION_AUTO_CLOSE_HOURS=12
# Days a soft-deleted session waits before hard delete.
SESSION_DELETE_GRACE_DAYS=7
# Days after which a closed session is auto-anonymized.
SESSION_ANONYMIZE_AFTER_DAYS=365

# --- Nickname rules ------------------------------------------
NICKNAME_MIN_LENGTH=1
NICKNAME_MAX_LENGTH=24

# --- Rate limiting -------------------------------------------
# Failed logins per email within the window before lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=10
LOGIN_LOCKOUT_MINUTES=15

# --- Logging -------------------------------------------------
# Absolute path, OUTSIDE the web document root.
LOG_PATH=/home/youruser/eduqr-app/logs
# debug | info | warning | error
LOG_LEVEL=warning

# --- Mail (reserved for Phase 11 password reset; unused in MVP) ---
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=noreply@eduqr.example.org
