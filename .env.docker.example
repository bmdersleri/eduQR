# ─────────────────────────────────────────────────────────────
# eduQR — Docker stack configuration [NFR-75]
# Copy this file to .env.docker and fill in local values.
# .env.docker is git-ignored. NEVER put real credentials here.
# It is read twice: as the app's .env inside the container and as
# the MySQL bootstrap configuration, so the DB_* / MYSQL_* pairs
# below MUST match each other.
# ─────────────────────────────────────────────────────────────

# --- Application ---------------------------------------------
APP_NAME=eduQR
APP_ENV=development
APP_URL=http://localhost:8080
APP_DEBUG=true
# Print one with `docker compose exec app php bin/rotate-secret.php` and paste
# it here (the container's .env is read-only, so --apply cannot write it).
APP_SECRET=replace-with-a-generated-secret

# --- Localization --------------------------------------------
APP_LOCALE_DEFAULT=en
APP_LOCALES=en,tr

# --- Database (app side) — DB_HOST is the compose service name ---
DB_HOST=db
DB_PORT=3306
DB_NAME=eduqr
DB_USER=eduqr_app
DB_PASS=replace-with-a-local-password

# --- Database (MySQL container bootstrap) --------------------
# MYSQL_DATABASE/USER/PASSWORD must match DB_NAME/DB_USER/DB_PASS above.
MYSQL_DATABASE=eduqr
MYSQL_USER=eduqr_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

# --- Sessions & Cookies --------------------------------------
SESSION_NAME=eduqr_session
SESSION_LIFETIME_MINUTES=720
# Kept true so the local stack uses the same cookie contract as production
# (NFR-23) and `composer test` passes inside the container. Browsers accept
# Secure cookies on http://localhost. Set false only if yours refuses them.
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax

# --- Logging -------------------------------------------------
LOG_PATH=/var/www/html/logs
LOG_LEVEL=debug

# --- Demo seed account (used by: php bin/seed.php demo) ------
DEMO_EMAIL=demo@example.org
DEMO_NAME=Demo Instructor
# Must satisfy the password policy: 10-128 chars, 3 of {lower, upper, digit, symbol}.
DEMO_PASSWORD=change-me-Demo1!
DEMO_ROLE=instructor
DEMO_LANG=tr
